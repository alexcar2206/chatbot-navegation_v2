# =============================================================================
# Environment templates
# - Production / demo stack:  cp .env.example .env
#                             ./scripts/prod-up.sh   (or docker compose -f docker-compose.yaml up)
# - Development (hot reload): cp .env.dev.example .env.dev
#                             ./scripts/dev-up.sh    (or docker compose -f docker-compose.dev.yaml up)
# =============================================================================

# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'
# Production compose enables Ollama. Dev compose defaults to ENABLE_OLLAMA_API=false (see .env.dev.example).
ENABLE_OLLAMA_API=true

# Space- or comma-separated models pulled on compose up by ollama-init
# (first boot can take several minutes; open-webui does not wait).
# Manual pull: ./scripts/ollama-pull-defaults.sh
# Seed registers the first model as admin-only (users do not see it in the chat selector).
OLLAMA_PULL_MODELS=llama3.2:3b

# Groq (OpenAI-compatible) — set OPENAI_API_KEY in your local .env / server secrets
OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
ENABLE_OPENAI_API=true

# Pre-selected chat model (workspace RAG assistant after webui-seed).
DEFAULT_MODELS=asistente-navegacion-mino

# Display name in sidebar, login, and browser titles (no automatic "Open WebUI" suffix).
WEBUI_NAME=Chatbot Navegation
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_SECRET_KEY=

# Optional JSON override for new-chat prompt chips. Empty uses navigation defaults in config.py.
# DEFAULT_PROMPT_SUGGESTIONS=[]

# Default admin created on first boot when the database is empty
# Local testing only — change password before any shared/production deploy.
WEBUI_ADMIN_EMAIL=admin@chatnavegation.local
WEBUI_ADMIN_PASSWORD=chatnavegation123
WEBUI_ADMIN_NAME=Admin

# Public registration creates users with this role (user | pending | admin)
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user

# First-boot seed: download docs ZIP, create Knowledge + workspace model (scripts/seed_webui.py).
# Leave empty to skip. Public GitHub Release asset recommended.
# First boot can take many minutes (Open WebUI startup + indexing). Full reset: docker compose down -v
# SEED_BASE_MODEL_ID (Groq): public + active + meta.hidden (hidden in chat selector, usable as assistant base).
# Seed also registers OLLAMA_PULL_MODELS[0] as admin-only so an admin can reassign the same assistant base for local tests.
SEED_DOCS_ZIP_URL=https://github.com/alexcar2206/chatbot-navegation_v2/releases/download/v0.1.0-docs/docs-navegation.zip
SEED_FORCE=false
SEED_MODEL_ID=asistente-navegacion-mino
SEED_BASE_MODEL_ID=openai/gpt-oss-20b
SEED_MODEL_NAME=Asistente Navegación Miño
SEED_WAIT_TIMEOUT=1800
# Shared volume path inside open-webui / webui-seed (docs ZIP extract for RAG + GDB)
SEED_DOCS_PACK_PATH=/data/docs_pack

# Lean RAG for Groq free-tier TPM (~8k). Smaller chunks apply after reindex (down -v).
RAG_TOP_K=1
RAG_TOP_K_RERANKER=1
CHUNK_SIZE=400

# Navigation map (Anexo 3 geo). Regenerated on open-webui startup from docs_pack GDB.
ENABLE_MAPA=true
# GEO_DOCS_PACK_PATH=/app/backend/data/docs_pack
# GEO_GDB_PATH=
# GEO_CACHE_PATH=/app/backend/data/geo_cache/zonas_navegacion.geojson
# GEO_CAPA_ZONAS=
REGENERAR_GEO_ON_START=auto

# Declaración responsable (DOCX). Plantilla Jinja from docs_pack EDITABLE form.
ENABLE_DECLARACION=true
# DR_EDITABLE_DOCX_PATH=
# DR_PLANTILLA_PATH=/app/backend/data/plantillas/plantilla_declaracion_responsable.docx
REGENERAR_PLANTILLA_ON_START=auto

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# Production: single host (built frontend + API). Dev compose uses
# CORS_ALLOW_ORIGIN=http://localhost:5173;http://localhost:8080 (see .env.dev.example).
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
# Off by default to reduce Groq TPM usage on free tier.
ENABLE_MEMORY_SYSTEM_CONTEXT=false

# Set to true to add compact row/column stats to parsed CSV retrieval context.
ENABLE_RAG_CSV_SUMMARY=false

# Set to true to preserve backing file records, storage blobs, and per-file vectors when files are removed from knowledge bases.
ENABLE_KNOWLEDGE_FILE_RETENTION=false

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
