# =============================================================================
# Development stack (docker-compose.dev.yaml) — copy to .env.dev and fill secrets
#   cp .env.dev.example .env.dev
# Default: Groq only, no Ollama. For local models: ENABLE_OLLAMA_API=true +
#   ./scripts/dev-up.sh --profile ollama
# =============================================================================

# Ollama off by default (lighter; office / 8GB friendly). Keep it false unless the
# ollama profile is running: an unreachable Ollama adds ~3s to every model list fetch.
ENABLE_OLLAMA_API=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PULL_MODELS=llama3.2:3b

# Groq (OpenAI-compatible) — required for chat in the default dev profile
OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
ENABLE_OPENAI_API=true

# Cache the base model list (Groq/Ollama) instead of querying every connection on
# each /api/models call; a slow or unreachable connection otherwise delays every page load.
# New upstream models show up after "Cache Base Model List" refresh or a connection save.
# Applies to a fresh database only; on an existing one use Admin > Settings > Connections.
ENABLE_BASE_MODELS_CACHE=true

DEFAULT_MODELS=asistente-navegacion-mino

WEBUI_NAME=Chatbot Navegación Miño-Sil
DEFAULT_LOCALE=es-ES
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_SECRET_KEY=

WEBUI_ADMIN_EMAIL=admin@chatnavegation.local
WEBUI_ADMIN_PASSWORD=chatnavegation123
WEBUI_ADMIN_NAME=Admin

ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user

# Seed (use: ./scripts/dev-up.sh --profile seed)
SEED_DOCS_ZIP_URL=https://github.com/alexcar2206/chatbot-navegation_v2/releases/download/v0.1.0-docs/docs-navegation.zip
SEED_FORCE=false
# Login hero media (fondo.webp + fondo.mp4). Same seed profile; failure only logs a warning.
SEED_AUTH_MEDIA_ZIP_URL=https://github.com/alexcar2206/chatbot-navegation_v2/releases/download/v0.1.0-auth/docs-auth.zip
SEED_AUTH_MEDIA_ZIP_SHA256=2ae3bd7bcb9b4d893442adffe859437f0cb713bb6800c987e5213a70f50eba64
SEED_AUTH_MEDIA_PATH=/data/auth
SEED_MODEL_ID=asistente-navegacion-mino
SEED_BASE_MODEL_ID=openai/gpt-oss-20b
SEED_MODEL_NAME=Asistente Navegación Miño
SEED_WAIT_TIMEOUT=1800
SEED_DOCS_PACK_PATH=/data/docs_pack

# Lean RAG for Groq free-tier TPM (~8k). Smaller chunks apply after reindex (down -v).
RAG_TOP_K=1
RAG_TOP_K_RERANKER=1
CHUNK_SIZE=400

ENABLE_MAPA=true
REGENERAR_GEO_ON_START=auto

ENABLE_DECLARACION=true
# DECLARACION_BORRADORES_TTL_DIAS=90
# DECLARACION_BORRADORES_MAX=50
REGENERAR_PLANTILLA_ON_START=auto

# Vite (5173) + backend (8080) — required for docker-compose.dev.yaml
CORS_ALLOW_ORIGIN=http://localhost:5173;http://localhost:8080

# Off by default to reduce Groq TPM usage on free tier.
ENABLE_MEMORY_SYSTEM_CONTEXT=false
ENABLE_RAG_CSV_SUMMARY=false
ENABLE_KNOWLEDGE_FILE_RETENTION=false
ENABLE_PLUGINS=false

# Features kept for CHMS: chat, notes, mapa, declaración, workspace, analytics.
ENABLE_NOTES=true
ENABLE_ADMIN_ANALYTICS=true
ENABLE_CHANNELS=false
ENABLE_CALENDAR=false
ENABLE_AUTOMATIONS=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_IMAGE_GENERATION=false
ENABLE_SCIM=false
ENABLE_VERSION_UPDATE_CHECK=false

FORWARDED_ALLOW_IPS='*'

SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
